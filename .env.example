# 접속 키 — 쉼표로 여러 개 등록 가능 (예: family-key,friend-key)
ACCESS_KEYS=

# 세션 쿠키 서명용 비밀 문자열 (npm run setup이 자동 생성)
SESSION_SECRET=

# local = 로컬 폴더(개발용) / drive = 구글 드라이브
STORAGE_DRIVER=local

# 로컬 어댑터가 사용할 폴더 (개발용)
LOCAL_STORAGE_ROOT=.devstorage

# 아래 값들은 npm run setup이 채운다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
