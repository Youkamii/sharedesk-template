# 관리자 이메일 — 이 계정으로 로그인하면 자동 승인되고 관리 화면이 열린다 (setup이 자동 기입)
ADMIN_EMAILS=

# 손님용 임시 접속 키 (선택) — 비워두면 구글 로그인만 사용
ACCESS_KEYS=

# 세션 쿠키 서명용 비밀 (필수, 16자 이상). npm run setup이 자동 생성한다.
# 없으면 앱이 로그인을 아예 거부한다 — 배포 시 환경변수로 반드시 옮길 것.
SESSION_SECRET=

# 배포 주소 (구글 로그인 콜백 URL 계산용). 비우면 요청 origin을 쓴다.
PUBLIC_BASE_URL=

# local = 로컬 폴더(개발용) / drive = 구글 드라이브
STORAGE_DRIVER=local

# 로컬 어댑터가 사용할 폴더 (개발용)
LOCAL_STORAGE_ROOT=.devstorage

# 아래 값들은 npm run setup이 채운다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
