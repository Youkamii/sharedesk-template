# 관리자 Google 이메일입니다. 여러 명이면 쉼표로 구분합니다.
# npm run setup은 호스트 이메일을 자동으로 넣습니다.
ADMIN_EMAILS=

# 임시 손님용 접속 키입니다. 선택 사항이며 여러 개면 쉼표로 구분합니다.
# 사용자별 승인과 회수가 필요하면 /admin의 초대 코드를 사용하세요.
ACCESS_KEYS=

# 로그인 쿠키 서명 비밀입니다. 16자 이상이어야 합니다.
# npm run setup이 안전한 무작위 값을 만듭니다. 운영에서는 직접 만든 개발용 예시를 쓰지 마세요.
SESSION_SECRET=

# 만료된 간이 링크 파일을 정리하는 Vercel Cron 인증 비밀입니다.
# npm run setup이 별도의 안전한 무작위 값을 만듭니다.
CRON_SECRET=

# 사용자 지정 도메인을 쓸 때 고정 운영 origin을 입력합니다.
# Vercel 기본 도메인은 VERCEL_PROJECT_PRODUCTION_URL을 자동으로 사용하므로 비워도 됩니다.
# 경로, 끝 슬래시, OAuth 콜백, Vercel Preview URL은 넣지 않습니다.
# 예: https://sharedesk.example.com
PUBLIC_BASE_URL=

# 관리자 업데이트 화면이 열 설치 저장소입니다. owner/repository 형식입니다.
# Deploy with Vercel이 저장소 정보를 제공하면 비워도 됩니다.
SHAREDESK_GITHUB_REPOSITORY=

# 원클릭 업데이트에 쓰는 GitHub 토큰입니다. 선택 사항이며 비우면 GitHub 화면 안내로 대신합니다.
# 설치 저장소만 대상으로 한 fine-grained PAT에 Actions Read and write 최소 권한만 주세요.
SHAREDESK_GITHUB_TOKEN=

# 선택 사항인 비공개 설치 등록부와 사용자 피드백 연결입니다. 두 값을 모두 채운
# 경우에만 설치 등록·피드백 동작이 서버에서 수집기로 요청합니다.
# 설치 비밀은 설치본마다 다른 정확히 32바이트 base64url 값(43자)이어야 합니다.
# 예: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 설치 ID는 이 비밀에서 자동으로 파생하므로 따로 설정하지 않습니다.
SHAREDESK_OWNER_REGISTRY_ENDPOINT=
SHAREDESK_OWNER_REGISTRY_SECRET=

# 데스크 기본 언어입니다. npm run setup이 설치 때 고른 값을 채웁니다.
# en / ko / ja / hi / zh 중 하나이며, 비우면 영어(en)로 동작합니다.
# 관리자가 /admin의 데스크 언어 설정을 저장하면 그 값이 우선합니다.
SHAREDESK_DEFAULT_LOCALE=

# local = OAuth 없는 로컬 개발 / drive = Google Drive 운영
STORAGE_DRIVER=local

# local 드라이버가 파일을 저장할 폴더입니다. 운영 drive 모드에서는 사용하지 않습니다.
LOCAL_STORAGE_ROOT=.devstorage

# Web application 유형의 Google OAuth 클라이언트입니다. 두 값은 직접 입력합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 아래 세 값은 npm run setup이 채웁니다. 여러 참여자가 함께 쓸 호스트 Drive 루트와 ShareDesk 상태입니다.
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
DRIVE_STATE_FOLDER_ID=

# 실제 Drive 공유 검사를 받을 별도 Google 계정입니다. 검사할 때만 로컬에 넣습니다.
# 운영 Vercel 환경 변수에는 추가하지 마세요.
SHAREDESK_SHARE_TEST_EMAIL=
