# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 로컬 dev 스토리지
/.devstorage

# setup 진행 중 임시 상태 (state/PKCE)
/.setup-pending.json
/.sharedesk-private-*
/.sharedesk-owner-tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# 로컬 문서 윤문 작업물
/_workspace/
